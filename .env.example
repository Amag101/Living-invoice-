# Copy to .env and fill in. Never commit .env.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# From the app's webhook settings, once the app has a public HTTPS URL
PAYPAL_WEBHOOK_ID=

# Where clients open their Living Invoice (your Render URL in production)
PUBLIC_URL=http://localhost:8790
CURRENCY_CODE=USD

# Claude (optional: turns on the AI layer)
ANTHROPIC_API_KEY=

# Offline demo against the fake PayPal sandbox instead of the real one:
#   python3 fake_paypal.py --webhook http://localhost:8790/webhooks/paypal
# PAYPAL_API_BASE=http://localhost:8791
# PAYPAL_CLIENT_ID=fake
# PAYPAL_CLIENT_SECRET=fake
# PAYPAL_WEBHOOK_ID=WH-FAKE-1
